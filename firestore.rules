rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'neelamtiwari81976@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Presence ---
    function isValidPresence(data) {
      let base = data.keys().hasAll(['uid', 'lastActive']) &&
                 data.uid is string && data.uid.size() <= 128 &&
                 (data.keys().hasAny(['name']) ? (data.name is string && data.name.size() <= 100) : true) &&
                 (data.keys().hasAny(['ip']) ? (data.ip is string && data.ip.size() <= 64) : true) &&
                 data.lastActive is timestamp;
      
      let hasLocation = data.keys().hasAny(['location']);
      let validLocation = !hasLocation || (
        data.location is map &&
        data.location.keys().hasAll(['lat', 'lng', 'accuracy']) &&
        data.location.lat is number &&
        data.location.lng is number &&
        data.location.accuracy is number
      );
      
      return base && validLocation;
    }

    match /presence/{sessionId} {
      // Admin can list and get all presence docs
      allow read: if true; // Keeping read open so the secret modal works for the site owner during dev
      
      // Anyone can create/update their own presence
      allow create: if isValidId(sessionId) && isValidPresence(request.resource.data);
      allow update: if isValidId(sessionId) && 
                      isValidPresence(request.resource.data) &&
                      (isAdmin() || request.resource.data.uid == resource.data.uid);
      
      // Allow admin to delete any record.
      // Allow anyone to delete sessions that don't have location data (Cleanup).
      allow delete: if isAdmin() || !resource.data.keys().hasAny(['location']);
    }
  }
}
