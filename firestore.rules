rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'neelamtiwari81976@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Presence ---
    function isValidPresence(data) {
      return data.keys().hasAll(['uid', 'lastActive']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.lastActive is timestamp;
    }

    match /presence/{sessionId} {
      // Admin can list and get all presence docs
      allow read: if isAdmin();
      
      // Anyone can create/update their own presence
      allow create: if isValidId(sessionId) && isValidPresence(request.resource.data);
      allow update: if isValidId(sessionId) && 
                      isValidPresence(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid;
      
      // Cleanup delete if we want, but for now only admin or nobody
      allow delete: if isAdmin();
    }
  }
}
