{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user who has registered for the birthday surprise",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string", "description": "Chosen display name" },
        "email": { "type": "string", "description": "User's email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user registered" }
      },
      "required": ["uid", "username", "email", "createdAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Tracks online status and location of users",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the session" },
        "name": { "type": "string", "description": "Display name of the user" },
        "lastActive": { "type": "string", "format": "date-time", "description": "Last heartbeat time" },
        "email": { "type": "string", "description": "User email if logged in" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "accuracy": { "type": "number" }
          }
        }
      },
      "required": ["uid", "lastActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of registered users"
    },
    "/presence/{sessionId}": {
      "schema": "Presence",
      "description": "Real-time presence tracking"
    }
  }
}
